{
  "name": "qwindowkit",
  "version": "1.5.0",
  "description": "Cross-platform frameless-window framework for Qt: custom-drawn title bars that keep native behaviors (snap, shadow, resize, Win11 snap-layouts).",
  "homepage": "https://github.com/stdware/qwindowkit",
  "license": "Apache-2.0",
  "supports": "windows",
  "dependencies": [
    "qmsetup",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "widgets"
      ]
    },
    "qtdeclarative",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
